{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vedant817/hinglish-shield/schemas/metrics.schema.json",
  "title": "HinglishShieldRunMetrics",
  "type": "object",
  "required": ["run_id", "config_hash", "model_id", "split", "languages", "metrics", "judges", "created_at"],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "config_hash": { "type": "string", "minLength": 1 },
    "model_id": { "type": "string", "minLength": 1 },
    "split": { "type": "string", "enum": ["dev", "test", "example"] },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asr": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "strongreject": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "over_refusal": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "capability": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "judges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string", "enum": ["primary", "secondary", "human"] }
        }
      }
    },
    "created_at": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" }
  }
}
